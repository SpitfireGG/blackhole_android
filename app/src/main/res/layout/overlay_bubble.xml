<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <ImageView
        android:id="@+id/overlay_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/overlay_circle"
        android:src="@mipmap/blackhole_icon"
        android:contentDescription="Download from clipboard" />

    <TextView
        android:id="@+id/overlay_badge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:gravity="center"
        android:background="@drawable/overlay_badge"
        android:textSize="10sp"
        android:textColor="#FFFFFF"
        android:text=""
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/overlay_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:textSize="11sp"
        android:textColor="#FFEFA860"
        android:alpha="0"
        android:text=""
        android:padding="2dp" />

</FrameLayout>
